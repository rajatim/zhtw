benchmark-blind-v2-pool-collecting-check: ## Rebuild and validate the current collecting pool
	$(PYTHON) scripts/promote_blind_v2_candidates.py $(foreach decision,$(BLIND_V2_CONFIRMED_DECISIONS),--decision $(decision)) --created-at 2026-07-28T06:31:36+08:00 --output $(BLIND_V2_POOL) --report docs/reports/blind-v2-candidate-promotion-batches-001-043-2026-07-28.md --check
	$(PYTHON) scripts/blind_v2_governance.py validate-pool $(BLIND_V2_POOL)

