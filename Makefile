	@test -n "$(REVIEWED_AT)" || (echo "REVIEWED_AT is required" >&2; exit 2)
	$(PYTHON) scripts/import_permissioned_user_report_issue.py --issue $(ISSUE) --write --maintainer $(MAINTAINER) --reviewed-at $(REVIEWED_AT)

