ans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-drought-zh-hans-v1/sentence-042","input":"安装泳池节水过滤器。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/drought","source_case_id":"sentence-042","split":"article"},"source_id":"ready-gov-drought-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-drought-zh-hans-v1/sentence-045","input":"在干旱期间，务必遵守州府和地方的用水限制。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/drought","source_case_id":"sentence-045","split":"article"},"source_id":"ready-gov-drought-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-drought-zh-hans-v1/sentence-046","input":"联系州府或当地政府，了解最新信息和建议。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/drought","source_case_id":"sentence-046","split":"article"},"source_id":"ready-gov-drought-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-drought-zh-hans-v1/sentence-048","input":"短时间洗淋浴，而非泡澡。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/drought","source_case_id":"sentence-048","split":"article"},"source_id":"ready-gov-drought-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-drought-zh-hans-v1/sentence-051","input":"洗衣机装满了衣服再洗，按衣服的多少设置水位。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/drought","source_case_id":"sentence-051","split":"article"},"source_id":"ready-gov-drought-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-drought-zh-hans-v1/sentence-053","input":"使用“轻洗”功能，