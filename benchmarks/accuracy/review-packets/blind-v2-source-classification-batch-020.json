{"batch_number":20,"batch_size":100,"cases":[{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"cisa-personal-security-zh-hans-v1/sentence-013","input":"您是否表现出某种群体身份，该身份会让您成为具有吸引力的目标？","provenance":{"raw_url":"https://www.cisa.gov/sites/default/files/2025-03/personal-security-considerations-action-guide-critical-infrastructure-workers_06-07-2024_508_ZHS.pdf","source_case_id":"sentence-013","split":"guide"},"source_id":"cisa-personal-security-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"cisa-personal-security-zh-hans-v1/sentence-015","input":"如果您对上述任何问题或所有问题回答了“是”，这可能表明您以及与您共事的其他关键基础设施员工面临风险，并且您应该评估自己的安全需求。","provenance":{"raw_url":"https://www.cisa.gov/sites/default/files/2025-03/personal-security-considerations-action-guide-critical-infrastructure-workers_06-07-2024_508_ZHS.pdf","source_case_id":"sentence-015","split":"guide"},"source_id":"cisa-personal-security-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"cisa-personal-security-zh-hans-v1/sentence-040","input":"如果公众抗议或示威活动发生在您家或您的营业场所附近，或甚至就发生在您的房产中，无论其任务和意图如何，请保持冷静。","provenance":{"raw_url":"https://www.cisa.gov/sites/default/files/2025-03/personal-security-considerations-action-guide-critical-infrastructure-workers_06-07-2024_508_ZHS.pdf","source_case_id":"sentence-040","split":"guide"},"source_id":"cisa-personal-security-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"cisa-personal-security-zh-hans-v1/sentence-045","input":"如有必要，请记下对在场人员和车辆的描述。","provenance":{"raw_url":"https://www.cisa.gov/sites/default/files/2025-03/personal-security-considerations-action-guide-critical-infrastructure-workers_06-07-2024_508_ZHS.pdf","source_case_id":"sentence-045","split":"guide"},"source_id":"cisa-personal-security-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"cisa-personal-security-zh-hans-v1/sentence-053","input":"考虑随时携带手机。","provenance":{"raw_url":"https://www.cisa.gov/sites/default/files/2025-03/personal-security-considerations-action-guide-critical-infrastructure-workers_06-07-2024_508_ZHS.pdf","source_case_id":"sentence-053","split":"guide"},"source_id":"cisa-personal-security-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"cisa-personal-security-zh-hans-v1/sentence-057","input":"采取适当的预防措施可以帮助您降低受伤和遭受暴力或侵犯的风险。","provenance":{"raw_url":"https://www.cisa.gov/sites/default/files/2025-03/personal-security-considerations-action-guide-critical-infrastructure-workers_06-07-2024_508_ZHS.pdf","source_case_id":"sentence-057","split":"guide"},"source_id":"cisa-personal-security-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"cisa-personal-security-zh-hans-v1/sentence-067","input":"避免打电话、戴耳机或发送长短信。","provenance":{"raw_url":"https://www.cisa.gov/sites/default/files/2025-03/personal-security-considerations-action-guide-critical-infrastructure-workers_06-07-2024_508_ZHS.pdf","source_case_id":"sentence-067","split":"guide"},"source_id":"cisa-personal-security-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"cisa-personal-security-zh-hans-v1/sentence-069","input":"使用银行 ATM 机时，请避免在公众视线范围内展示货币。","provenance":{"raw_url":"https://www.cisa.gov/sites/default/files/2025-03/personal-security-considerations-action-guide-critical-infrastructure-workers_06-07-2024_508_ZHS.pdf","source_case_id":"sentence-069","split":"guide"},"source_id":"cisa-personal-security-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"cisa-personal-security-zh-hans-v1/sentence-080","input":"在社交媒体上传播任何实施攻击的图像或想法。","provenance":{"raw_url":"https://www.cisa.gov/sites/default/files/2025-03/personal-security-considerations-action-guide-critical-infrastructure-workers_06-07-2024_508_ZHS.pdf","source_case_id":"sentence-080","split":"guide"},"source_id":"cisa-personal-security-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"cisa-personal-security-zh-hans-v1/sentence-095","input":"确保在旅途中锁好所有车门和后备箱。","provenance":{"raw_url":"https://www.cisa.gov/sites/default/files/2025-03/personal-security-considerations-action-guide-critical-infrastructure-workers_06-07-2024_508_ZHS.pdf","source_case_id":"sentence-095","split":"guide"},"source_id":"cisa-personal-security-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"cisa-personal-security-zh-hans-v1/sentence-097","input":"安全驾驶，与前方车辆保持安全距离。","provenance":{"raw_url":"https://www.cisa.gov/sites/default/files/2025-03/personal-security-considerations-action-guide-critical-infrastructure-workers_06-07-2024_508_ZHS.pdf","source_case_id":"sentence-097","split":"guide"},"source_id":"cisa-personal-security-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"cisa-personal-security-zh-hans-v1/sentence-102","input":"如果可以，请前往最近的警察局，切勿开车回家。","provenance":{"raw_url":"https://www.cisa.gov/sites/default/files/2025-03/personal-security-considerations-action-guide-critical-infrastructure-workers_06-07-2024_508_ZHS.pdf","source_case_id":"sentence-102","split":"guide"},"source_id":"cisa-personal-security-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"cisa-personal-security-zh-hans-v1/sentence-128","input":"如果担心自身人身安全，请联系当地执法部门了解下一步措施。","provenance":{"raw_url":"https://www.cisa.gov/sites/default/files/2025-03/personal-security-considerations-action-guide-critical-infrastructure-workers_06-07-2024_508_ZHS.pdf","source_case_id":"sentence-128","split":"guide"},"source_id":"cisa-personal-security-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ftc-heads-up-simplified-v1/sentence-015","input":"问一下自己：“想不想让某人在午餐时与全餐厅的人分享那张照片或者那个视频？”","provenance":{"raw_url":"https://consumer.ftc.gov/system/files/consumer_ftc_gov/pdf/792A_Heads%20Up%20Stop%20Think%20Connect_Chinese-Simplified_508.pdf","source_case_id":"sentence-015","split":"booklet"},"source_id":"ftc-heads-up-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ftc-heads-up-simplified-v1/sentence-019","input":"发布前问一下他们：“您同意我在社交媒体上发布这个东西吗？”","provenance":{"raw_url":"https://consumer.ftc.gov/system/files/consumer_ftc_gov/pdf/792A_Heads%20Up%20Stop%20Think%20Connect_Chinese-Simplified_508.pdf","source_case_id":"sentence-019","split":"booklet"},"source_id":"ftc-heads-up-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ftc-heads-up-simplified-v1/sentence-034","input":"网上容易产生误解。","provenance":{"raw_url":"https://consumer.ftc.gov/system/files/consumer_ftc_gov/pdf/792A_Heads%20Up%20Stop%20Think%20Connect_Chinese-Simplified_508.pdf","source_case_id":"sentence-034","split":"booklet"},"source_id":"ftc-heads-up-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ftc-heads-up-simplified-v1/sentence-039","input":"网上书写的这种风格就跟面对面大喊大叫一样没有区别。","provenance":{"raw_url":"https://consumer.ftc.gov/system/files/consumer_ftc_gov/pdf/792A_Heads%20Up%20Stop%20Think%20Connect_Chinese-Simplified_508.pdf","source_case_id":"sentence-039","split":"booklet"},"source_id":"ftc-heads-up-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ftc-heads-up-simplified-v1/sentence-062","input":"检查自己的位置设置。","provenance":{"raw_url":"https://consumer.ftc.gov/system/files/consumer_ftc_gov/pdf/792A_Heads%20Up%20Stop%20Think%20Connect_Chinese-Simplified_508.pdf","source_case_id":"sentence-062","split":"booklet"},"source_id":"ftc-heads-up-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ftc-heads-up-simplified-v1/sentence-069","input":"每次都扪心自问：“这个应用软件需要知道我的位置吗？”","provenance":{"raw_url":"https://consumer.ftc.gov/system/files/consumer_ftc_gov/pdf/792A_Heads%20Up%20Stop%20Think%20Connect_Chinese-Simplified_508.pdf","source_case_id":"sentence-069","split":"booklet"},"source_id":"ftc-heads-up-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ftc-heads-up-simplified-v1/sentence-071","input":"通过短信、社交媒体或电子游戏交朋友可能很有趣 — 但有些人的实际身份与网上身份大相径庭。","provenance":{"raw_url":"https://consumer.ftc.gov/system/files/consumer_ftc_gov/pdf/792A_Heads%20Up%20Stop%20Think%20Connect_Chinese-Simplified_508.pdf","source_case_id":"sentence-071","split":"booklet"},"source_id":"ftc-heads-up-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ftc-heads-up-simplified-v1/sentence-075","input":"即使邮件像是来自认识的朋友、家人或公司 — 或者说不回复会有不好的后果也不要给出个人信息。","provenance":{"raw_url":"https://consumer.ftc.gov/system/files/consumer_ftc_gov/pdf/792A_Heads%20Up%20Stop%20Think%20Connect_Chinese-Simplified_508.pdf","source_case_id":"sentence-075","split":"booklet"},"source_id":"ftc-heads-up-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ftc-heads-up-simplified-v1/sentence-093","input":"不要与任何人分享密码，即使是最好的朋友或恋人。","provenance":{"raw_url":"https://consumer.ftc.gov/system/files/consumer_ftc_gov/pdf/792A_Heads%20Up%20Stop%20Think%20Connect_Chinese-Simplified_508.pdf","source_case_id":"sentence-093","split":"booklet"},"source_id":"ftc-heads-up-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ftc-heads-up-simplified-v1/sentence-102","input":"多重身份验证将你知道的事物（例如密码）和你有的事物（例如应用软件生成的密码）或你自身（例如指纹）组合到一起。","provenance":{"raw_url":"https://consumer.ftc.gov/system/files/consumer_ftc_gov/pdf/792A_Heads%20Up%20Stop%20Think%20Connect_Chinese-Simplified_508.pdf","source_case_id":"sentence-102","split":"booklet"},"source_id":"ftc-heads-up-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ftc-heads-up-simplified-v1/sentence-103","input":"如果密码泄露，请迅速更改。","provenance":{"raw_url":"https://consumer.ftc.gov/system/files/consumer_ftc_gov/pdf/792A_Heads%20Up%20Stop%20Think%20Connect_Chinese-Simplified_508.pdf","source_case_id":"sentence-103","split":"booklet"},"source_id":"ftc-heads-up-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ftc-heads-up-simplified-v1/sentence-106","input":"什么是最好的在线体验方式？","provenance":{"raw_url":"https://consumer.ftc.gov/system/files/consumer_ftc_gov/pdf/792A_Heads%20Up%20Stop%20Think%20Connect_Chinese-Simplified_508.pdf","source_case_id":"sentence-106","split":"booklet"},"source_id":"ftc-heads-up-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ftc-heads-up-simplified-v1/sentence-109","input":"这样有助于防范新的安全威胁。","provenance":{"raw_url":"https://consumer.ftc.gov/system/files/consumer_ftc_gov/pdf/792A_Heads%20Up%20Stop%20Think%20Connect_Chinese-Simplified_508.pdf","source_case_id":"sentence-109","split":"booklet"},"source_id":"ftc-heads-up-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"osha-chainsaw-safety-simplified-v1/sentence-002","input":"检查控制装置、链条张力以及所有的螺栓和手柄，以确保它们正常工作并依照制造商的说明书进行了调整。","provenance":{"raw_url":"https://www.osha.gov/sites/default/files/publications/OSHA4286.pdf","source_case_id":"sentence-002","split":"document"},"source_id":"osha-chainsaw-safety-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"osha-chainsaw-safety-simplified-v1/sentence-009","input":"切勿尝试为运行中的链锯或热的链锯加油。","provenance":{"raw_url":"https://www.osha.gov/sites/default/files/publications/OSHA4286.pdf","source_case_id":"sentence-009","split":"document"},"source_id":"osha-chainsaw-safety-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"osha-chainsaw-safety-simplified-v1/sentence-012","input":"在崎岖不平的地形上搬运链锯时，请关闭链锯或接通链锯制动器。","provenance":{"raw_url":"https://www.osha.gov/sites/default/files/publications/OSHA4286.pdf","source_case_id":"sentence-012","split":"document"},"source_id":"osha-chainsaw-safety-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"osha-chainsaw-safety-simplified-v1/sentence-016","input":"注意不要让树干或树枝卡住锯条。","provenance":{"raw_url":"https://www.osha.gov/sites/default/files/publications/OSHA4286.pdf","source_case_id":"sentence-016","split":"document"},"source_id":"osha-chainsaw-safety-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"osha-chainsaw-safety-simplified-v1/sentence-020","input":"保持端头防护装置开启。","provenance":{"raw_url":"https://www.osha.gov/sites/default/files/publications/OSHA4286.pdf","source_case_id":"sentence-020","split":"document"},"source_id":"osha-chainsaw-safety-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"osha-disaster-cleanup-simplified-v1/sentence-002","input":"清理和重建活动中蕴含着可能导致严重伤害甚至死亡的危险。","provenance":{"raw_url":"https://www.osha.gov/sites/default/files/publications/OSHA_FS-4355.pdf","source_case_id":"sentence-002","split":"document"},"source_id":"osha-disaster-cleanup-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"osha-disaster-cleanup-simplified-v1/sentence-025","input":"被倒下的树枝砸中或压伤。","provenance":{"raw_url":"https://www.osha.gov/sites/default/files/publications/OSHA_FS-4355.pdf","source_case_id":"sentence-025","split":"document"},"source_id":"osha-disaster-cleanup-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"osha-disaster-cleanup-simplified-v1/sentence-027","input":"在抬起、移动树枝和其他碎片时拉伤和扭伤。","provenance":{"raw_url":"https://www.osha.gov/sites/default/files/publications/OSHA_FS-4355.pdf","source_case_id":"sentence-027","split":"document"},"source_id":"osha-disaster-cleanup-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"osha-disaster-cleanup-simplified-v1/sentence-028","input":"联系供电公司断电，并将电力线进行接地或屏蔽。","provenance":{"raw_url":"https://www.osha.gov/sites/default/files/publications/OSHA_FS-4355.pdf","source_case_id":"sentence-028","split":"document"},"source_id":"osha-disaster-cleanup-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"osha-disaster-cleanup-simplified-v1/sentence-042","input":"注意场地里湿滑的表面、障碍物或不平坦的地方。","provenance":{"raw_url":"https://www.osha.gov/sites/default/files/publications/OSHA_FS-4355.pdf","source_case_id":"sentence-042","split":"document"},"source_id":"osha-disaster-cleanup-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"osha-disaster-cleanup-simplified-v1/sentence-045","input":"由于加油及燃料储存不当而引起的火灾。","provenance":{"raw_url":"https://www.osha.gov/sites/default/files/publications/OSHA_FS-4355.pdf","source_case_id":"sentence-045","split":"document"},"source_id":"osha-disaster-cleanup-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"osha-disaster-cleanup-simplified-v1/sentence-053","input":"使用适当的照明、信号旗手和工地通讯。","provenance":{"raw_url":"https://www.osha.gov/sites/default/files/publications/OSHA_FS-4355.pdf","source_case_id":"sentence-053","split":"document"},"source_id":"osha-disaster-cleanup-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"osha-disaster-cleanup-simplified-v1/sentence-054","input":"确保车辆操作人员已经接受适当的培训。","provenance":{"raw_url":"https://www.osha.gov/sites/default/files/publications/OSHA_FS-4355.pdf","source_case_id":"sentence-054","split":"document"},"source_id":"osha-disaster-cleanup-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"osha-disaster-cleanup-simplified-v1/sentence-055","input":"始终使用安全带和翻车保护装置。","provenance":{"raw_url":"https://www.osha.gov/sites/default/files/publications/OSHA_FS-4355.pdf","source_case_id":"sentence-055","split":"document"},"source_id":"osha-disaster-cleanup-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"osha-disaster-cleanup-simplified-v1/sentence-057","input":"进入受限的、有窒息危险的地方，以及其他的密闭空间。","provenance":{"raw_url":"https://www.osha.gov/sites/default/files/publications/OSHA_FS-4355.pdf","source_case_id":"sentence-057","split":"document"},"source_id":"osha-disaster-cleanup-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"osha-disaster-cleanup-simplified-v1/sentence-060","input":"正确选择和使用个人防护装备（PPE），其中可能包括呼吸保护设备，同时遵守29 CFR 1926.1101中所列的其他程序。","provenance":{"raw_url":"https://www.osha.gov/sites/default/files/publications/OSHA_FS-4355.pdf","source_case_id":"sentence-060","split":"document"},"source_id":"osha-disaster-cleanup-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"osha-disaster-cleanup-simplified-v1/sentence-063","input":"通过在构筑定边坡、边坡、撑柱或掩护支架来防止塌陷。","provenance":{"raw_url":"https://www.osha.gov/sites/default/files/publications/OSHA_FS-4355.pdf","source_case_id":"sentence-063","split":"document"},"source_id":"osha-disaster-cleanup-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"osha-disaster-cleanup-simplified-v1/sentence-076","input":"语音电话是(202)693-1999；电传打字机(TTY)是： (877)889-5627。","provenance":{"raw_url":"https://www.osha.gov/sites/default/files/publications/OSHA_FS-4355.pdf","source_case_id":"sentence-076","split":"document"},"source_id":"osha-disaster-cleanup-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"osha-fallen-workers-family-simplified-v1/sentence-001","input":"来自 Tonya Ford的信息 OSHA家庭联络员亲人的离世是一个家庭最痛苦的事情之一。","provenance":{"raw_url":"https://www.osha.gov/sites/default/files/publications/FALLEN-WORKERS-BROCHURE-2023-ZH-SI.pdf","source_case_id":"sentence-001","split":"document"},"source_id":"osha-fallen-workers-family-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"osha-fallen-workers-family-simplified-v1/sentence-003","input":"请在您方便的时候与我联系。","provenance":{"raw_url":"https://www.osha.gov/sites/default/files/publications/FALLEN-WORKERS-BROCHURE-2023-ZH-SI.pdf","source_case_id":"sentence-003","split":"document"},"source_id":"osha-fallen-workers-family-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"osha-fallen-workers-family-simplified-v1/sentence-005","input":"OSHA 对您的损失深表遗憾。","provenance":{"raw_url":"https://www.osha.gov/sites/default/files/publications/FALLEN-WORKERS-BROCHURE-2023-ZH-SI.pdf","source_case_id":"sentence-005","split":"document"},"source_id":"osha-fallen-workers-family-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"osha-fallen-workers-family-simplified-v1/sentence-006","input":"我们将竭诚为您服务。","provenance":{"raw_url":"https://www.osha.gov/sites/default/files/publications/FALLEN-WORKERS-BROCHURE-2023-ZH-SI.pdf","source_case_id":"sentence-006","split":"document"},"source_id":"osha-fallen-workers-family-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"osha-fallen-workers-family-simplified-v1/sentence-009","input":"承认你的失落和哀伤感情。","provenance":{"raw_url":"https://www.osha.gov/sites/default/files/publications/FALLEN-WORKERS-BROCHURE-2023-ZH-SI.pdf","source_case_id":"sentence-009","split":"document"},"source_id":"osha-fallen-workers-family-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"osha-fallen-workers-family-simplified-v1/sentence-010","input":"专注于可以掌控的生活方面。","provenance":{"raw_url":"https://www.osha.gov/sites/default/files/publications/FALLEN-WORKERS-BROCHURE-2023-ZH-SI.pdf","source_case_id":"sentence-010","split":"document"},"source_id":"osha-fallen-workers-family-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"osha-fallen-workers-family-simplified-v1/sentence-012","input":"22 个州计划（21 个州和波多黎各）既包括私营企业，也包括州和地方政府部门。","provenance":{"raw_url":"https://www.osha.gov/sites/default/files/publications/FALLEN-WORKERS-BROCHURE-2023-ZH-SI.pdf","source_case_id":"sentence-012","split":"document"},"source_id":"osha-fallen-workers-family-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"osha-fallen-workers-family-simplified-v1/sentence-018","input":"您可以与当地的 OSHA 办事处联系，询问案件的进展情况或提出问题。","provenance":{"raw_url":"https://www.osha.gov/sites/default/files/publications/FALLEN-WORKERS-BROCHURE-2023-ZH-SI.pdf","source_case_id":"sentence-018","split":"document"},"source_id":"osha-fallen-workers-family-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"osha-fallen-workers-family-simplified-v1/sentence-019","input":"如果你能提供有助于检查的信息或证据，请通过写信、打电话或发电子邮件的方式与当地 OSHA 办事处分享。","provenance":{"raw_url":"https://www.osha.gov/sites/default/files/publications/FALLEN-WORKERS-BROCHURE-2023-ZH-SI.pdf","source_case_id":"sentence-019","split":"document"},"source_id":"osha-fallen-workers-family-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"osha-small-business-consultation-simplified-v1/sentence-001","input":"每个已避免的工伤节省大约 8500美元，一个已避免的工人赔偿诉求可以让您的保险率，以及受伤致病率保持在低水平，而这可以让您在其他公司选择可靠的业务合作伙伴时更加具有吸引力。","provenance":{"raw_url":"https://www.osha.gov/sites/default/files/publications/OSHA4230.pdf","source_case_id":"sentence-001","split":"document"},"source_id":"osha-small-business-consultation-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"osha-small-business-consultation-simplified-v1/sentence-003","input":"工人更倾向于留在一个关注他们健康的公司。","provenance":{"raw_url":"https://www.osha.gov/sites/default/files/publications/OSHA4230.pdf","source_case_id":"sentence-003","split":"document"},"source_id":"osha-small-business-consultation-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"osha-small-business-consultation-simplified-v1/sentence-006","input":"安全咨询可以帮助企业去提问和思考必要的问题，来创建一个安全的工作环境。","provenance":{"raw_url":"https://www.osha.gov/sites/default/files/publications/OSHA4230.pdf","source_case_id":"sentence-006","split":"document"},"source_id":"osha-small-business-consultation-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"osha-small-business-consultation-simplified-v1/sentence-009","input":"目标是在现在以及未来去降低工人受伤或致疾的可能性。","provenance":{"raw_url":"https://www.osha.gov/sites/default/files/publications/OSHA4230.pdf","source_case_id":"sentence-009","split":"document"},"source_id":"osha-small-business-consultation-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"osha-small-business-consultation-simplified-v1/sentence-012","input":"顾问会与管理层和工人代表会面，谈论顾问的职责和雇主的义务。","provenance":{"raw_url":"https://www.osha.gov/sites/default/files/publications/OSHA4230.pdf","source_case_id":"sentence-012","split":"document"},"source_id":"osha-small-business-consultation-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"osha-small-business-consultation-simplified-v1/sentence-014","input":"顾问可以审阅您的安全与健康管理项目，甚至可以免费为您提供职业健康样本。","provenance":{"raw_url":"https://www.osha.gov/sites/default/files/publications/OSHA4230.pdf","source_case_id":"sentence-014","split":"document"},"source_id":"osha-small-business-consultation-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"osha-small-business-consultation-simplified-v1/sentence-016","input":"您会得知需要提高哪些方面，您所做的正确举动，成本方面的考虑，以及如何持续进步。","provenance":{"raw_url":"https://www.osha.gov/sites/default/files/publications/OSHA4230.pdf","source_case_id":"sentence-016","split":"document"},"source_id":"osha-small-business-consultation-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"osha-small-business-consultation-simplified-v1/sentence-020","input":"他们的专业背景，结合OSHA 的培训，使他们成为了理想选择，来帮助您找到有安全与健康隐患之处，不管是在您所有的设备中，还是在部分设备中。","provenance":{"raw_url":"https://www.osha.gov/sites/default/files/publications/OSHA4230.pdf","source_case_id":"sentence-020","split":"document"},"source_id":"osha-small-business-consultation-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"osha-work-zone-traffic-simplified-v1/sentence-003","input":"司机、徒步工人和行人必须能够看到并理解正确的路线。","provenance":{"raw_url":"https://www.osha.gov/sites/default/files/publications/OSHA4291.pdf","source_case_id":"sentence-003","split":"document"},"source_id":"osha-work-zone-traffic-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"osha-work-zone-traffic-simplified-v1/sentence-006","input":"经批准的交通控制装置，包括锥筒、桶、分隔物和标志物，也可在作业区内使用。","provenance":{"raw_url":"https://www.osha.gov/sites/default/files/publications/OSHA4291.pdf","source_case_id":"sentence-006","split":"document"},"source_id":"osha-work-zone-traffic-simplified-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-earthquakes-zh-hans-v1/sentence-006","input":"安排好走散了在哪里见面。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/earthquakes","source_case_id":"sentence-006","split":"article"},"source_id":"ready-gov-earthquakes-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-earthquakes-zh-hans-v1/sentence-015","input":"标准的房主保险不包括地震损坏。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/earthquakes","source_case_id":"sentence-015","split":"article"},"source_id":"ready-gov-earthquakes-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-earthquakes-zh-hans-v1/sentence-017","input":"放好驻车制动器。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/earthquakes","source_case_id":"sentence-017","split":"article"},"source_id":"ready-gov-earthquakes-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-earthquakes-zh-hans-v1/sentence-019","input":"如在户外，应远离建筑物。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/earthquakes","source_case_id":"sentence-019","split":"article"},"source_id":"ready-gov-earthquakes-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-earthquakes-zh-hans-v1/sentence-020","input":"如在室内，呆在里面，不要跑到外面，避开门口。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/earthquakes","source_case_id":"sentence-020","split":"article"},"source_id":"ready-gov-earthquakes-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-earthquakes-zh-hans-v1/sentence-023","input":"用手臂盖住头部和颈部。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/earthquakes","source_case_id":"sentence-023","split":"article"},"source_id":"ready-gov-earthquakes-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-earthquakes-zh-hans-v1/sentence-027","input":"保持双膝着地或弯腰，护好重要器官。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/earthquakes","source_case_id":"sentence-027","split":"article"},"source_id":"ready-gov-earthquakes-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-earthquakes-zh-hans-v1/sentence-028","input":"如在桌子或书桌下面，用一只手扶好，准备好随之移动。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/earthquakes","source_case_id":"sentence-028","split":"article"},"source_id":"ready-gov-earthquakes-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-earthquakes-zh-hans-v1/sentence-034","input":"不要进入损坏的建筑物。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/earthquakes","source_case_id":"sentence-034","split":"article"},"source_id":"ready-gov-earthquakes-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-earthquakes-zh-hans-v1/sentence-036","input":"用衬衫捂住嘴部，保护好自己，不要大喊大叫，而要使用哨子。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/earthquakes","source_case_id":"sentence-036","split":"article"},"source_id":"ready-gov-earthquakes-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-earthquakes-zh-hans-v1/sentence-037","input":"如果所在地区可能发生海啸，在震动停止后应立即前往内陆或地势较高的地方。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/earthquakes","source_case_id":"sentence-037","split":"article"},"source_id":"ready-gov-earthquakes-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-earthquakes-zh-hans-v1/sentence-045","input":"切勿尝试自行清除沉重的碎屑。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/earthquakes","source_case_id":"sentence-045","split":"article"},"source_id":"ready-gov-earthquakes-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-earthquakes-zh-hans-v1/sentence-048","input":"儿童不应参加灾后清理工作。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/earthquakes","source_case_id":"sentence-048","split":"article"},"source_id":"ready-gov-earthquakes-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-floods-zh-hans-v1/sentence-003","input":"由雨、雪、沿海风暴、风暴潮及大坝和其他水系统溢流造成。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/floods","source_case_id":"sentence-003","split":"article"},"source_id":"ready-gov-floods-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-floods-zh-hans-v1/sentence-011","input":"不要靠近快速流动水面上的桥梁。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/floods","source_case_id":"sentence-011","split":"article"},"source_id":"ready-gov-floods-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-floods-zh-hans-v1/sentence-016","input":"紧急警示系统 (EAS) 和国家海洋和大气管理局 (NOAA) 气象无线电也提供紧急情况警示。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/floods","source_case_id":"sentence-016","split":"article"},"source_id":"ready-gov-floods-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-floods-zh-hans-v1/sentence-030","input":"切勿开车绕过路障。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/floods","source_case_id":"sentence-030","split":"article"},"source_id":"ready-gov-floods-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-floods-zh-hans-v1/sentence-032","input":"如果生病并需要就医，请联系医护人员。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/floods","source_case_id":"sentence-032","split":"article"},"source_id":"ready-gov-floods-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-floods-zh-hans-v1/sentence-033","input":"如果可能，请等待进一步的医护服务说明和适当的庇护所。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/floods","source_case_id":"sentence-033","split":"article"},"source_id":"ready-gov-floods-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-floods-zh-hans-v1/sentence-034","input":"收听 EAS、NOAA 天气广播或当地警示系统，了解有关洪水的最新紧急信息和说明。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/floods","source_case_id":"sentence-034","split":"article"},"source_id":"ready-gov-floods-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-floods-zh-hans-v1/sentence-036","input":"如果车被困在快速的流水中，待在车内。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/floods","source_case_id":"sentence-036","split":"article"},"source_id":"ready-gov-floods-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-floods-zh-hans-v1/sentence-037","input":"如果车内有水上升，爬到车顶上。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/floods","source_case_id":"sentence-037","split":"article"},"source_id":"ready-gov-floods-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-floods-zh-hans-v1/sentence-041","input":"注意有关当局的信息和说明。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/floods","source_case_id":"sentence-041","split":"article"},"source_id":"ready-gov-floods-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-floods-zh-hans-v1/sentence-044","input":"在清理过程中，应戴上重型工作手套、防护服和靴子，并在清理霉菌或其他杂物时戴好适当的面罩或口罩。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/floods","source_case_id":"sentence-044","split":"article"},"source_id":"ready-gov-floods-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-floods-zh-hans-v1/sentence-050","input":"如果安全，要关闭电源以防触电。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/floods","source_case_id":"sentence-050","split":"article"},"source_id":"ready-gov-floods-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-hurricanes-zh-hans-v1/sentence-006","input":"大西洋飓风季：6月1日至11月30日。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/hurricanes","source_case_id":"sentence-006","split":"article"},"source_id":"ready-gov-hurricanes-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-hurricanes-zh-hans-v1/sentence-007","input":"中太平洋台风季：6月1日至11月30日。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/hurricanes","source_case_id":"sentence-007","split":"article"},"source_id":"ready-gov-hurricanes-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-hurricanes-zh-hans-v1/sentence-008","input":"了解您的飓风风险飓风不仅是沿海地区的问题。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/hurricanes","source_case_id":"sentence-008","split":"article"},"source_id":"ready-gov-hurricanes-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-hurricanes-zh-hans-v1/sentence-012","input":"确保您的企业制定了业务连续性计划，以便在灾难发生时维持运营。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/hurricanes","source_case_id":"sentence-012","split":"article"},"source_id":"ready-gov-hurricanes-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-hurricanes-zh-hans-v1/sentence-015","input":"遵循当地应急管理人员的指示，他们会与州、地方、部落及领地机构和合作伙伴密切协作。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/hurricanes","source_case_id":"sentence-015","split":"article"},"source_id":"ready-gov-hurricanes-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-hurricanes-zh-hans-v1/sentence-024","input":"收集物资为家庭储备足够的物资。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/hurricanes","source_case_id":"sentence-024","split":"article"},"source_id":"ready-gov-hurricanes-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-hurricanes-zh-hans-v1/sentence-029","input":"若您居住在强制疏散区，且当地官员要求您撤离，请立即行动。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/hurricanes","source_case_id":"sentence-029","split":"article"},"source_id":"ready-gov-hurricanes-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-hurricanes-zh-hans-v1/sentence-031","input":"在指定的风暴避难所或室内房间避风。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/hurricanes","source_case_id":"sentence-031","split":"article"},"source_id":"ready-gov-hurricanes-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-hurricanes-zh-hans-v1/sentence-033","input":"不要爬进封闭的阁楼。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/hurricanes","source_case_id":"sentence-033","split":"article"},"source_id":"ready-gov-hurricanes-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-hurricanes-zh-hans-v1/sentence-039","input":"清理霉菌或其他杂物时，请穿戴防护服并使用合适的面部防护罩或口罩。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/hurricanes","source_case_id":"sentence-039","split":"article"},"source_id":"ready-gov-hurricanes-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-hurricanes-zh-hans-v1/sentence-040","input":"患有哮喘、其他肺部疾病和/或免疫功能低下的人士，即使对霉菌不过敏，也不应进入室内有漏水或可见、可闻霉菌滋生的建筑物。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/hurricanes","source_case_id":"sentence-040","split":"article"},"source_id":"ready-gov-hurricanes-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-hurricanes-zh-hans-v1/sentence-052","input":"请联系您的保险公司寻求帮助。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/hurricanes","source_case_id":"sentence-052","split":"article"},"source_id":"ready-gov-hurricanes-zh