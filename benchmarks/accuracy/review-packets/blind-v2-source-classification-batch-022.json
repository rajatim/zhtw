{"batch_number":22,"batch_size":100,"cases":[{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-drought-zh-hans-v1/sentence-001","input":"美国几乎每个地区都会经历降雨减少的时期。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/drought","source_case_id":"sentence-001","split":"article"},"source_id":"ready-gov-drought-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-drought-zh-hans-v1/sentence-003","input":"防备干旱的最好方法就是节水。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/drought","source_case_id":"sentence-003","split":"article"},"source_id":"ready-gov-drought-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-drought-zh-hans-v1/sentence-005","input":"还能作他用时，切勿将水倒入下水道，例如，可用来浇灌室内植物或花园。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/drought","source_case_id":"sentence-005","split":"article"},"source_id":"ready-gov-drought-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-drought-zh-hans-v1/sentence-011","input":"将水管绝缘，减少热量损失，防止破裂。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/drought","source_case_id":"sentence-011","split":"article"},"source_id":"ready-gov-drought-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-drought-zh-hans-v1/sentence-012","input":"仅在水中矿物质会损坏管道时才安装软水系统。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/drought","source_case_id":"sentence-012","split":"article"},"source_id":"ready-gov-drought-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-drought-zh-hans-v1/sentence-016","input":"安装马桶排水装置，减少冲洗所需水量。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/drought","source_case_id":"sentence-016","split":"article"},"source_id":"ready-gov-drought-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-drought-zh-hans-v1/sentence-017","input":"在水箱中放一个一加仑的塑料水罐取代马桶水流。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/drought","source_case_id":"sentence-017","split":"article"},"source_id":"ready-gov-drought-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-drought-zh-hans-v1/sentence-020","input":"不要使用垃圾处理器，将食物扔进垃圾箱或堆肥堆处理。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/drought","source_case_id":"sentence-020","split":"article"},"source_id":"ready-gov-drought-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-drought-zh-hans-v1/sentence-022","input":"种植当地和/或耐旱的青草、地被、灌木和树木，长成后无需太多浇水。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/drought","source_case_id":"sentence-022","split":"article"},"source_id":"ready-gov-drought-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-drought-zh-hans-v1/sentence-024","input":"除非使用循环再用水，否则不要安装装饰性水景（如喷泉）。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/drought","source_case_id":"sentence-024","split":"article"},"source_id":"ready-gov-drought-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-drought-zh-hans-v1/sentence-031","input":"割草时留得更高，草根就能长得更深，留住更多土壤水分。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/drought","source_case_id":"sentence-031","split":"article"},"source_id":"ready-gov-drought-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-drought-zh-hans-v1/sentence-033","input":"减少或消除不常用的草坪。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/drought","source_case_id":"sentence-033","split":"article"},"source_id":"ready-gov-drought-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-drought-zh-hans-v1/sentence-037","input":"秋冬两季仅在需要时手动浇水。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/drought","source_case_id":"sentence-037","split":"article"},"source_id":"ready-gov-drought-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-drought-zh-hans-v1/sentence-039","input":"购买天气或智能灌溉控制器。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/drought","source_case_id":"sentence-039","split":"article"},"source_id":"ready-gov-drought-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-drought-zh-hans-v1/sentence-044","input":"盖好泳池和水疗设备，减少水蒸发。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/drought","source_case_id":"sentence-044","split":"article"},"source_id":"ready-gov-drought-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-drought-zh-hans-v1/sentence-047","input":"将纸巾、昆虫和其他类似废物放入垃圾桶，而非马桶。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/drought","source_case_id":"sentence-047","split":"article"},"source_id":"ready-gov-drought-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-drought-zh-hans-v1/sentence-049","input":"只在湿身和用皂时打开水，然后再打开水洗净。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/drought","source_case_id":"sentence-049","split":"article"},"source_id":"ready-gov-drought-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-drought-zh-hans-v1/sentence-057","input":"接住用作他用（如植物浇水），或在炉子上或微波炉中加热。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/drought","source_case_id":"sentence-057","split":"article"},"source_id":"ready-gov-drought-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-drought-zh-hans-v1/sentence-061","input":"大雨过后，两周内都不需要浇水。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/drought","source_case_id":"sentence-061","split":"article"},"source_id":"ready-gov-drought-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-drought-zh-hans-v1/sentence-065","input":"踩着时会弹回来，草坪就不需要水。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/drought","source_case_id":"sentence-065","split":"article"},"source_id":"ready-gov-drought-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-drought-zh-hans-v1/sentence-067","input":"要让草坪能更好地吸收水分并避免径流，分几次短时间浇水，而非一次长时间浇水。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/drought","source_case_id":"sentence-067","split":"article"},"source_id":"ready-gov-drought-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-drought-zh-hans-v1/sentence-068","input":"在车道或人行道上清洁树叶和其他碎屑时，应使用扫帚或鼓风机，而非水管。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/drought","source_case_id":"sentence-068","split":"article"},"source_id":"ready-gov-drought-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-drought-zh-hans-v1/sentence-069","input":"使用洒水器或水管时，一定要有人看着。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/drought","source_case_id":"sentence-069","split":"article"},"source_id":"ready-gov-drought-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-drought-zh-hans-v1/sentence-070","input":"一根花园水管几个小时就能流出至少 600 加仑水。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/drought","source_case_id":"sentence-070","split":"article"},"source_id":"ready-gov-drought-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-drought-zh-hans-v1/sentence-071","input":"极度干旱时，让草坪枯死，保住树木和大灌木。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/drought","source_case_id":"sentence-071","split":"article"},"source_id":"ready-gov-drought-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-home-fires-zh-hans-v1/sentence-006","input":"吸入这种超热空气会烧焦肺部，让衣服融化在皮肤上。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/home-fires","source_case_id":"sentence-006","split":"article"},"source_id":"ready-gov-home-fires-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-home-fires-zh-hans-v1/sentence-007","input":"火焰开始很亮，但很快就会产生黑烟和完全黑暗。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/home-fires","source_case_id":"sentence-007","split":"article"},"source_id":"ready-gov-home-fires-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-home-fires-zh-hans-v1/sentence-013","input":"每 10 年或根据制造商说明更换整个烟雾报警器。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/home-fires","source_case_id":"sentence-013","split":"article"},"source_id":"ready-gov-home-fires-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-home-fires-zh-hans-v1/sentence-015","input":"视障者可用听觉警报器，听障者可用带振动垫或闪光灯的烟雾警报器。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/home-fires","source_case_id":"sentence-015","split":"article"},"source_id":"ready-gov-home-fires-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-home-fires-zh-hans-v1/sentence-017","input":"如已投保，联系保险公司获取详细说明，了解如何保护财产、进行盘点和联系火灾损失复原公司。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/home-fires","source_case_id":"sentence-017","split":"article"},"source_id":"ready-gov-home-fires-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-home-fires-zh-hans-v1/sentence-019","input":"逃生计划有助于快速离家。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/home-fires","source_case_id":"sentence-019","split":"article"},"source_id":"ready-gov-home-fires-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-home-fires-zh-hans-v1/sentence-023","input":"练习在黑暗中或闭着眼睛摸索走出家门。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/home-fires","source_case_id":"sentence-023","split":"article"},"source_id":"ready-gov-home-fires-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-home-fires-zh-hans-v1/sentence-024","input":"教导孩子不要躲避消防员。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/home-fires","source_case_id":"sentence-024","split":"article"},"source_id":"ready-gov-home-fires-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-home-fires-zh-hans-v1/sentence-026","input":"睡觉时关上卧室门。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/home-fires","source_case_id":"sentence-026","split":"article"},"source_id":"ready-gov-home-fires-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-home-fires-zh-hans-v1/sentence-028","input":"联系当地消防部门，获取有关正确使用和维护的协助。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/home-fires","source_case_id":"sentence-028","split":"article"},"source_id":"ready-gov-home-fires-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-home-fires-zh-hans-v1/sentence-039","input":"如果衣服着火，停下、趴下和滚动：立即停下，趴在地上，用手盖住脸部。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/home-fires","source_case_id":"sentence-039","split":"article"},"source_id":"ready-gov-home-fires-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-home-fires-zh-hans-v1/sentence-045","input":"与消防部门核实，确保住所可以安全进入。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/home-fires","source_case_id":"sentence-045","split":"article"},"source_id":"ready-gov-home-fires-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-home-fires-zh-hans-v1/sentence-049","input":"清点物品之前，切勿丢弃任何损坏的物品。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/home-fires","source_case_id":"sentence-049","split":"article"},"source_id":"ready-gov-home-fires-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-home-fires-zh-hans-v1/sentence-050","input":"先放好任何火灾损失费用相关收据。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/home-fires","source_case_id":"sentence-050","split":"article"},"source_id":"ready-gov-home-fires-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-home-fires-zh-hans-v1/sentence-054","input":"人人都可采取下列简单步骤来防止悲剧发生。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/home-fires","source_case_id":"sentence-054","split":"article"},"source_id":"ready-gov-home-fires-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-home-fires-zh-hans-v1/sentence-057","input":"烹饪时要穿短袖、紧身袖或卷紧的袖子。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/home-fires","source_case_id":"sentence-057","split":"article"},"source_id":"ready-gov-home-fires-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-home-fires-zh-hans-v1/sentence-058","input":"将烤肉架放在离壁板和露台栏杆至少 10 英尺的地方，远离屋檐和悬垂的树枝。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/home-fires","source_case_id":"sentence-058","split":"article"},"source_id":"ready-gov-home-fires-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-home-fires-zh-hans-v1/sentence-061","input":"如果电器有三孔插头，则只能在三槽插座中使用。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/home-fires","source_case_id":"sentence-061","split":"article"},"source_id":"ready-gov-home-fires-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-home-fires-zh-hans-v1/sentence-062","input":"切勿强行插入双槽插座或延长线。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/home-fires","source_case_id":"sentence-062","split":"article"},"source_id":"ready-gov-home-fires-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-home-fires-zh-hans-v1/sentence-063","input":"如果电灯开关发热且灯在闪烁，立即关闭，然后聘请专业人士更换。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/home-fires","source_case_id":"sentence-063","split":"article"},"source_id":"ready-gov-home-fires-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-home-fires-zh-hans-v1/sentence-071","input":"每年检查和清洁柴炉管道和烟囱，每月检查是否有损坏或阻塞。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/home-fires","source_case_id":"sentence-071","split":"article"},"source_id":"ready-gov-home-fires-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-home-fires-zh-hans-v1/sentence-072","input":"使用足够重的壁炉屏风，阻止滚动的柴火，要大到足以覆盖壁炉的整个开口才能挡住飞溅的火花。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/home-fires","source_case_id":"sentence-072","split":"article"},"source_id":"ready-gov-home-fires-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-home-fires-zh-hans-v1/sentence-082","input":"切勿使用燃气灶或烤箱为住房供暖。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/home-fires","source_case_id":"sentence-082","split":"article"},"source_id":"ready-gov-home-fires-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-home-fires-zh-hans-v1/sentence-084","input":"使用燃气炉作为热源尤其危险，因为一氧化碳会积聚起来并达到一个危险水平，使您和家人面临一氧化碳中毒的危险。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/home-fires","source_case_id":"sentence-084","split":"article"},"source_id":"ready-gov-home-fires-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-home-fires-zh-hans-v1/sentence-085","input":"让可燃和易燃液体远离热源。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/home-fires","source_case_id":"sentence-085","split":"article"},"source_id":"ready-gov-home-fires-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-landslides-debris-flow-zh-hans-v1/sentence-001","input":"山体滑坡发生在美国所有州和地区，可能由许多因素引起，包括地震、风暴、火山爆发、火灾和土地的人为改造。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/landslides-debris-flow","source_case_id":"sentence-001","split":"article"},"source_id":"ready-gov-landslides-debris-flow-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-landslides-debris-flow-zh-hans-v1/sentence-002","input":"最危险、最危及生命和最致命的山体滑坡是那些发生得很快的山体滑坡，通常很少有人注意到。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/landslides-debris-flow","source_case_id":"sentence-002","split":"article"},"source_id":"ready-gov-landslides-debris-flow-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-landslides-debris-flow-zh-hans-v1/sentence-004","input":"当野火烧毁斜坡时，会在数年内增加山体滑坡的可能性。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/landslides-debris-flow","source_case_id":"sentence-004","split":"article"},"source_id":"ready-gov-landslides-debris-flow-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-landslides-debris-flow-zh-hans-v1/sentence-009","input":"虽然这些山体滑坡很少造成人员伤亡，但随着时间的推移，它们会对土地和财产造成破坏。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/landslides-debris-flow","source_case_id":"sentence-009","split":"article"},"source_id":"ready-gov-landslides-debris-flow-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-landslides-debris-flow-zh-hans-v1/sentence-011","input":"注册您社区的警告系统。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/landslides-debris-flow","source_case_id":"sentence-011","split":"article"},"source_id":"ready-gov-landslides-debris-flow-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-landslides-debris-flow-zh-hans-v1/sentence-012","input":"紧急警报系统(EAS)和美国国家海洋和大气管理局(NOAA)天气广播也提供紧急警报。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/landslides-debris-flow","source_case_id":"sentence-012","split":"article"},"source_id":"ready-gov-landslides-debris-flow-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-landslides-debris-flow-zh-hans-v1/sentence-014","input":"将SHELTER + 您的邮政编码发送至43362( 4FEMA )，以查找您所在地区最近的避难所（例如：避难所 12345）。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/landslides-debris-flow","source_case_id":"sentence-014","split":"article"},"source_id":"ready-gov-landslides-debris-flow-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-landslides-debris-flow-zh-hans-v1/sentence-019","input":"在泥石流地区，考虑建造渠道或偏转墙以尝试引导建筑物周围的流动。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/landslides-debris-flow","source_case_id":"sentence-019","split":"article"},"source_id":"ready-gov-landslides-debris-flow-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-landslides-debris-flow-zh-hans-v1/sentence-023","input":"国家洪水保险计划(NFIP)的洪水保险政策可能涵盖泥石流。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/landslides-debris-flow","source_case_id":"sentence-023","split":"article"},"source_id":"ready-gov-landslides-debris-flow-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-landslides-debris-flow-zh-hans-v1/sentence-025","input":"聆听并注意是否有湍急的水流、泥浆或异常的声音。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/landslides-debris-flow","source_case_id":"sentence-025","split":"article"},"source_id":"ready-gov-landslides-debris-flow-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-landslides-debris-flow-zh-hans-v1/sentence-028","input":"景观中的巨石可能是过去泥石流的迹象。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/landslides-debris-flow","source_case_id":"sentence-028","split":"article"},"source_id":"ready-gov-landslides-debris-flow-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-landslides-debris-flow-zh-hans-v1/sentence-029","input":"您的景观会发生变化，例如斜坡上的雨水排放模式（尤其是径流汇集的地方）、陆地运动、小滑坡、水流或逐渐倾斜的树木。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/landslides-debris-flow","source_case_id":"sentence-029","split":"article"},"source_id":"ready-gov-landslides-debris-flow-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-landslides-debris-flow-zh-hans-v1/sentence-037","input":"栅栏、挡土墙、电线杆或树木倾斜或移动。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/landslides-debris-flow","source_case_id":"sentence-037","split":"article"},"source_id":"ready-gov-landslides-debris-flow-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-landslides-debris-flow-zh-hans-v1/sentence-039","input":"使用电池供电的收音机收听当地新闻台的警告。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/landslides-debris-flow","source_case_id":"sentence-039","split":"article"},"source_id":"ready-gov-landslides-debris-flow-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-landslides-debris-flow-zh-hans-v1/sentence-045","input":"切勿过有水或泥流的马路。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/landslides-debris-flow","source_case_id":"sentence-045","split":"article"},"source_id":"ready-gov-landslides-debris-flow-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-landslides-debris-flow-zh-hans-v1/sentence-047","input":"如果您确实被困在山体滑坡的路径上，请尽快上坡。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/landslides-debris-flow","source_case_id":"sentence-047","split":"article"},"source_id":"ready-gov-landslides-debris-flow-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-landslides-debris-flow-zh-hans-v1/sentence-049","input":"如果您靠近溪流或河道，请注意水流突然增加或减少或水从清澈变为浑浊。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/landslides-debris-flow","source_case_id":"sentence-049","split":"article"},"source_id":"ready-gov-landslides-debris-flow-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-landslides-debris-flow-zh-hans-v1/sentence-050","input":"这些可能是山体滑坡即将来临的迹象。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/landslides-debris-flow","source_case_id":"sentence-050","split":"article"},"source_id":"ready-gov-landslides-debris-flow-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-landslides-debris-flow-zh-hans-v1/sentence-051","input":"额外的载玻片可能会带来危险。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/landslides-debris-flow","source_case_id":"sentence-051","split":"article"},"source_id":"ready-gov-landslides-debris-flow-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-landslides-debris-flow-zh-hans-v1/sentence-052","input":"收听当地电台或电视台的最新紧急信息。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/landslides-debris-flow","source_case_id":"sentence-052","split":"article"},"source_id":"ready-gov-landslides-debris-flow-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-landslides-debris-flow-zh-hans-v1/sentence-053","input":"洪水有时会在山体滑坡和泥石流之后发生，因为它们可能是由相同的条件引发的。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/landslides-debris-flow","source_case_id":"sentence-053","split":"article"},"source_id":"ready-gov-landslides-debris-flow-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-landslides-debris-flow-zh-hans-v1/sentence-057","input":"报告潜在危险将使公用设施尽快关闭，防止进一步的危险和伤害。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/landslides-debris-flow","source_case_id":"sentence-057","split":"article"},"source_id":"ready-gov-landslides-debris-flow-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-landslides-debris-flow-zh-hans-v1/sentence-058","input":"让受过培训的专业人员检查建筑物地基、烟囱和周围土地是否有损坏。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/landslides-debris-flow","source_case_id":"sentence-058","split":"article"},"source_id":"ready-gov-landslides-debris-flow-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-landslides-debris-flow-zh-hans-v1/sentence-060","input":"向岩土工程专家寻求建议以评估滑坡危害或设计纠正技术以降低滑坡风险。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/landslides-debris-flow","source_case_id":"sentence-060","split":"article"},"source_id":"ready-gov-landslides-debris-flow-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-landslides-debris-flow-zh-hans-v1/sentence-061","input":"专业人士可以建议您预防或降低山体滑坡风险的最佳方法，而不会造成进一步的危险。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/landslides-debris-flow","source_case_id":"sentence-061","split":"article"},"source_id":"ready-gov-landslides-debris-flow-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-radiation-zh-hans-v1/sentence-001","input":"辐射紧急情况有不同类型，其造成的损害程度和对公众造成的危害程度各不相同。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/radiation","source_case_id":"sentence-001","split":"article"},"source_id":"ready-gov-radiation-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-radiation-zh-hans-v1/sentence-004","input":"您可以通过知道在发生事故时该怎么做并做好准备来保护您家人的安全。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/radiation","source_case_id":"sentence-004","split":"article"},"source_id":"ready-gov-radiation-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-radiation-zh-hans-v1/sentence-008","input":"有几种接收紧急警报的方法。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/radiation","source_case_id":"sentence-008","split":"article"},"source_id":"ready-gov-radiation-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-radiation-zh-hans-v1/sentence-010","input":"从您当地的应急管理机构注册您所在地区的社区警报，以接收您所在地区的及时和具体信息。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/radiation","source_case_id":"sentence-010","split":"article"},"source_id":"ready-gov-radiation-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-radiation-zh-hans-v1/sentence-011","input":"有一个电池供电或手摇曲柄收音机，如果其他形式的通信失败，它们还会继续工作。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/radiation","source_case_id":"sentence-011","split":"article"},"source_id":"ready-gov-radiation-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-radiation-zh-hans-v1/sentence-013","input":"包括为每个家庭成员准备的备用换洗衣服、一个用于装受污染衣物的垃圾袋以及密封的食物、水和药品。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/radiation","source_case_id":"sentence-013","split":"article"},"source_id":"ready-gov-radiation-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-radiation-zh-hans-v1/sentence-014","input":"制定家庭应急通信计划。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/radiation","source_case_id":"sentence-014","split":"article"},"source_id":"ready-gov-radiation-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-radiation-zh-hans-v1/sentence-015","input":"如果您不能在家里见面，请确定您的家人可以会面的地点。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/radiation","source_case_id":"sentence-015","split":"article"},"source_id":"ready-gov-radiation-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-radiation-zh-hans-v1/sentence-016","input":"确定您可以告知您的行踪和安全的州外联系人。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/radiation","source_case_id":"sentence-016","split":"article"},"source_id":"ready-gov-radiation-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-radiation-zh-hans-v1/sentence-017","input":"如果您需要撤离，请与朋友或家人一起制定计划，以确定安全的住宿地点。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/radiation","source_case_id":"sentence-017","split":"article"},"source_id":"ready-gov-radiation-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-radiation-zh-hans-v1/sentence-018","input":"熟悉学校、工作和护理机构关于留在室内/就地避难和疏散的计划。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/radiation","source_case_id":"sentence-018","split":"article"},"source_id":"ready-gov-radiation-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-radiation-zh-hans-v1/sentence-019","input":"在任何辐射应急过程中，都要遵循时间、距离、屏蔽的辐射防护原则。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/radiation","source_case_id":"sentence-019","split":"article"},"source_id":"ready-gov-radiation-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-radiation-zh-hans-v1/sentence-020","input":"限制暴露在辐射下的时间，尽可能远离放射源，并深入坚固的建筑物内以保护自己免受辐射。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/radiation","source_case_id":"sentence-020","split":"article"},"source_id":"ready-gov-radiation-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-radiation-zh-hans-v1/sentence-021","input":"如果紧急情况发生在室外，请进入室内。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/radiation","source_case_id":"sentence-021","split":"article"},"source_id":"ready-gov-radiation-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-radiation-zh-hans-v1/sentence-032","input":"最安全的建筑物有砖墙或混凝土墙。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/radiation","source_case_id":"sentence-032","split":"article"},"source_id":"ready-gov-radiation-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-radiation-zh-hans-v1/sentence-035","input":"在最初的24小时内，辐射水平迅速下降，危险性明显降低。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/radiation","source_case_id":"sentence-035","split":"article"},"source_id":"ready-gov-radiation-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-radiation-zh-hans-v1/sentence-036","input":"待在室内：除非另有说明，否则请避难。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/radiation","source_case_id":"sentence-036","split":"article"},"source_id":"ready-gov-radiation-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-radiation-zh-hans-v1/sentence-039","input":"如果指示您在辐射紧急情况下待在室内，宠物和服务性动物也应待在室内。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/radiation","source_case_id":"sentence-039","split":"article"},"source_id":"ready-gov-radiation-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-radiation-zh-hans-v1/sentence-040","input":"庇护通常持续至少 24 小时。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/radiation","source_case_id":"sentence-040","split":"article"},"source_id":"ready-gov-radiation-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-radiation-zh-hans-v1/sentence-043","input":"如果您已经撤离，请不要返回，直到当地政府告知您可以安全返回。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/radiation","source_case_id":"sentence-043","split":"article"},"source_id":"ready-gov-radiation-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-radiation-zh-hans-v1/sentence-044","input":"如果您在放射性释放期间在室外，或者您认为自己身上有放射性物质，可以通过简单的步骤将其去除。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/radiation","source_case_id":"sentence-044","split":"article"},"source_id":"ready-gov-radiation-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-radiation-zh-hans-v1/sentence-049","input":"如果可能，淋浴或用肥皂和水清洗，以去除皮肤或头发上未被覆盖的任何放射性颗粒。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/radiation","source_case_id":"sentence-049","split":"article"},"source_id":"ready-gov-radiation-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-radiation-zh-hans-v1/sentence-050","input":"如果您无法清洗，请使用抹布或干净的湿布擦拭未覆盖的任何皮肤或头发。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/radiation","source_case_id":"sentence-050","split":"article"},"source_id":"ready-gov-radiation-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-radiation-zh-hans-v1/sentence-057","input":"只要在使用前用湿毛巾或布擦拭容器，就可以安全地食用外面密封容器中的食物。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/radiation","source_case_id":"sentence-057","split":"article"},"source_id":"ready-gov-radiation-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-radiation-zh-hans-v1/sentence-060","input":"在当局告诉您安全之前，不要食用您花园里的食物，或在室外且没有包装的食物或液体。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/radiation","source_case_id":"sentence-060","split":"article"},"source_id":"ready-gov-radiation-zh-hans-v1"}],"converter_output_used":false,"dataset":"blind-v2","generated_date":"2026-07-27","input_only":true,"name":"blind-v2-source-classification-batch-022","seed":20260719,"selection_policy":"equal-source-deterministic-sha256-v1","selection_round":1,"source_snapshots":[{"id":"ready-gov-drought-zh-hans-v1","path":"benchmarks/accuracy/external/ready-gov-drought-zh-hans-v1.json","sha256":"34eb615c6b32d9b2cd44b6426ea4c6597a6432d68265a52a0011be8e9022b243"},{"id":"ready-gov-home-fires-zh-hans-v1","path":"benchmarks/accuracy/external/ready-gov-home-fires-zh-hans-v1.json","sha256":"76a56bd96aeae1b1f0884621c7375f1b5230e83da4d35c5d1cc2c28cc8e895fc"},{"id":"ready-gov-landslides-debris-flow-zh-hans-v1","path":"benchmarks/accuracy/external/ready-gov-landslides-debris-flow-zh-hans-v1.json","sha256":"7590fc46de434118eada4522fc09ec5e7423c4e332093382912a668bce7d68ce"},{"id":"ready-gov-radiation-zh-hans-v1","path":"benchmarks/accuracy/external/ready-gov-radiation-zh-hans-v1.json","sha256":"99b68ade2794ff3b382d2dabff537ed4b74d2404a4fe427d99d78d330ba9dff4"}],"stats":{"by_source":{"ready-gov-drought-zh-hans-v1":25,"ready-gov-home-fires-zh-hans-v1":25,"ready-gov-landslides-debris-flow-zh-hans-v1":25,"ready-gov-radiation-zh-hans-v1":25},"total":100},"status":"needs_codex_first_pass","version":1}
