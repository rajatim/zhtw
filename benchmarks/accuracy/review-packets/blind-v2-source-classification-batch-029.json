":null},"id":"ready-gov-landslides-debris-flow-zh-hans-v1/sentence-017","input":"您无法阻止或改变泥石流的路径。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/landslides-debris-flow","source_case_id":"sentence-017","split":"article"},"source_id":"ready-gov-landslides-debris-flow-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-landslides-debris-flow-zh-hans-v1/sentence-024","input":"如果您在野火燃烧区附近，请注册紧急警报并注意燃烧区的天气预报。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/landslides-debris-flow","source_case_id":"sentence-024","split":"article"},"source_id":"ready-gov-landslides-debris-flow-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-landslides-debris-flow-zh-hans-v1/sentence-032","input":"外墙、人行道或楼梯开始远离建筑物。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/landslides-debris-flow","source_case_id":"sentence-032","split":"article"},"source_id":"ready-gov-landslides-debris-flow-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-landslides-debris-flow-zh-hans-v1/sentence-034","input":"地下公用事业线路断裂。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/landslides-debris-flow","source_case_id":"sentence-034","split":"article"},"source_id":"ready-gov-landslides-debris-flow-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_flags":[],"risk":null,"script":null},"id":"ready-gov-landslides-debris-flow-zh-hans-v1/sentence-035","input":"隆起的地面出现在斜坡的底部。","provenance":{"raw_url":"https://www.ready.gov/zh-hans/landslides-debris-flow","source_case_id":"sentence-035","split":"article"},"source_id":"ready-gov-landslides-debris-flow-zh-hans-v1"},{"classification":{"confidence":null,"domain":null,"eligible":null,"notes":"","quality_f