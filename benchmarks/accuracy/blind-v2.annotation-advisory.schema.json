{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rajatim/zhtw/benchmarks/accuracy/blind-v2.annotation-advisory.schema.json",
  "title": "zhtw Blind-v2 private annotation advisory",
  "type": "object",
  "required": [
    "version", "dataset", "batch_id", "stage", "reviewer", "model", "review_date",
    "packet_sha256", "policy", "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "dataset": { "type": "string", "const": "blind-v2" },
    "batch_id": { "type": "string", "pattern": "^blind-v2-annotation-batch-[0-9]{3}$" },
    "stage": { "type": "string", "enum": ["codex_first_pass", "agy_independent"] },
    "reviewer": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "review_date": { "type": "string", "format": "date" },
    "packet_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "execution": {
      "type": "object",
      "required": ["cli", "cli_version", "conversation_ids", "chunk_size", "statuses", "turns"],
      "additionalProperties": false,
      "properties": {
        "cli": { "type": "string", "const": "agy" },
        "cli_version": { "type": "string", "minLength": 1 },
        "conversation_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "chunk_size": { "type": "integer", "minimum": 1, "maximum": 25 },
        "statuses": {
          "type": "array", "minItems": 1,
          "items": { "type": "string", "const": "SUCCESS" }
        },
        "turns": {
          "type": "array", "minItems": 1,
          "items": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "policy": {
      "type": "object",
      "required": ["input_only", "converter_output_not_used", "other_advisory_not_seen"],
      "additionalProperties": false,
      "properties": {
        "input_only": { "type": "boolean", "const": true },
        "converter_output_not_used": { "type": "boolean", "const": true },
        "other_advisory_not_seen": { "type": "boolean", "const": true }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["id", "expected", "acceptable", "confidence", "notes"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^blind-v2-candidate-[0-9]{6}$" },
          "expected": { "type": "string", "minLength": 1 },
          "acceptable": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
