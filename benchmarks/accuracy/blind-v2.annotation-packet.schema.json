{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rajatim/zhtw/benchmarks/accuracy/blind-v2.annotation-packet.schema.json",
  "title": "zhtw Blind-v2 private annotation packet",
  "type": "object",
  "required": [
    "version", "dataset", "batch_id", "inputs_sha256", "selection", "policy", "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "dataset": { "type": "string", "const": "blind-v2" },
    "batch_id": { "type": "string", "pattern": "^blind-v2-annotation-batch-[0-9]{3}$" },
    "inputs_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "selection": {
      "type": "object",
      "required": ["offset", "limit", "total_inputs"],
      "additionalProperties": false,
      "properties": {
        "offset": { "type": "integer", "minimum": 0 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
        "total_inputs": { "type": "integer", "minimum": 600 }
      }
    },
    "policy": {
      "type": "object",
      "required": ["input_only", "converter_output_forbidden", "expected_text_private"],
      "additionalProperties": false,
      "properties": {
        "input_only": { "type": "boolean", "const": true },
        "converter_output_forbidden": { "type": "boolean", "const": true },
        "expected_text_private": { "type": "boolean", "const": true }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["id", "input", "domain", "risk"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^blind-v2-candidate-[0-9]{6}$" },
          "input": { "type": "string", "minLength": 1 },
          "domain": {
            "type": "string",
            "enum": ["it_api_cli", "ui_i18n", "llm_generated", "formal_news", "social_daily", "high_stakes"]
          },
          "risk": {
            "type": "string",
            "enum": ["candidate_gap", "baseline_guard", "over_conversion_guard"]
          }
        }
      }
    }
  }
}
