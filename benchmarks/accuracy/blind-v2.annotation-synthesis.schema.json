{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rajatim/zhtw/benchmarks/accuracy/blind-v2.annotation-synthesis.schema.json",
  "title": "zhtw Blind-v2 private Codex annotation synthesis",
  "type": "object",
  "required": [
    "version", "dataset", "batch_id", "stage", "packet_sha256",
    "codex_advisory_sha256", "agy_advisory_sha256", "stats", "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "dataset": { "type": "string", "const": "blind-v2" },
    "batch_id": { "type": "string", "pattern": "^blind-v2-annotation-batch-[0-9]{3}$" },
    "stage": { "type": "string", "const": "codex_synthesis" },
    "packet_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "codex_advisory_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "agy_advisory_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "stats": {
      "type": "object",
      "required": ["total", "agreement", "codex", "agy", "hybrid", "needs_maintainer_review"],
      "additionalProperties": false,
      "properties": {
        "total": { "type": "integer", "minimum": 1, "maximum": 100 },
        "agreement": { "type": "integer", "minimum": 0 },
        "codex": { "type": "integer", "minimum": 0 },
        "agy": { "type": "integer", "minimum": 0 },
        "hybrid": { "type": "integer", "minimum": 0 },
        "needs_maintainer_review": { "type": "integer", "minimum": 0 }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "id", "expected", "acceptable", "decision", "confidence",
          "needs_maintainer_review", "rationale"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^blind-v2-candidate-[0-9]{6}$" },
          "expected": { "type": "string", "minLength": 1 },
          "acceptable": {
            "type": "array", "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "decision": { "type": "string", "enum": ["agreement", "codex", "agy", "hybrid"] },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "needs_maintainer_review": { "type": "boolean" },
          "rationale": { "type": "string" }
        }
      }
    }
  }
}
